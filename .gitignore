# Build outputs
/build/
*.o
*.obj
*.a
*.lib
*.exe
*.pdb
*.class

# Allow the recovered deobfuscated artifacts DLL/PKG to ship
!artifacts/*.dll
!artifacts/*.pkg

# Runtime and crash artifacts
*.log
hs_err_pid*
replay_pid*
*.dmp

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local caches
.cache/
.zig-cache/
zig-cache/

# Binary Ninja temp databases
*.bndb
